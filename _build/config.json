{
  "name": "Zendesk",
  "lowCaseName": "zendesk",
  "description": "Zendesk Hook for MODX FormIt",
  "author": "matdave",
  "version": "1.1.0-pl",
  "package": {
    "elements": {
      "snippets": [
        {
          "name": "zdHook",
          "file": "zdhook.php"
        }
      ]
    },
    "systemSettings": [
      {
        "key": "domain"
      },
      {
        "key": "client_id"
      },
      {
        "key": "client_secret",
        "type": "text-password"
      },
      {
        "key": "scope",
        "value": "tickets:read tickets:write users:read users:write"
      }
    ]
  }
}
